# MedVision AI Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=MedVision AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Database
DATABASE_URL=postgresql+asyncpg://medvision:medvision@localhost:5432/medvision
DATABASE_URL_SYNC=postgresql://medvision:medvision@localhost:5432/medvision

# JWT Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=medvision-ai-data

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=medvision-brain-tumor

# DVC
DVC_REMOTE=s3
DVC_REMOTE_URL=s3://medvision-ai-dvc

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# LLM (optional)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
ALLOW_PHI_TO_LLM=false

# RAG
CHROMA_PERSIST_DIR=./data/chroma
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Model Serving
MODEL_REGISTRY_PATH=./data/models
DEFAULT_MODEL=unet
INFERENCE_DEVICE=cuda
USE_MIXED_PRECISION=true
USE_TORCH_COMPILE=false

# Dataset
BRATS_DATA_PATH=./datasets/brats
PREPROCESSED_CACHE_PATH=./data/cache
TRAIN_VAL_SPLIT=0.8

# Monitoring
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FILE=./logs/medvision.log

# CORS
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
